# ======================
# Dependencies
# ======================
# Installed by `npm install` — never commit these (huge, reproducible)
node_modules/

# ======================
# Production Build
# ======================
# Generated by `npm run build` — not source code, don't track
build/

# ======================
# Environment Variables
# ======================
# May contain API keys, secrets — never commit
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ======================
# Logs
# ======================
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ======================
# OS Files
# ======================
.DS_Store        # macOS folder metadata
Thumbs.db        # Windows thumbnail cache

# ======================
# Editor / IDE
# ======================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ======================
# Testing
# ======================
coverage/        # generated by `npm test -- --coverage`

# ======================
# Misc Create React App
# ======================
.eslintcache